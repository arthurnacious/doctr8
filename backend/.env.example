# doctr8 backend configuration. Copy to .env and fill in the secrets:
#
#   cp .env.example .env
#   openssl rand -hex 24      # each database password
#   openssl rand -base64 48   # JWT_SECRET
#
# Variables already set in the environment take precedence over .env.

# --- Database -----------------------------------------------------------------
# Runtime connection. Must be doctr8_app (NOSUPERUSER, NOBYPASSRLS) so that
# row-level security is enforced on every query.
DATABASE_URL=postgres://doctr8_app:CHANGE_ME@localhost:5432/doctr8

# Schema owner, used only by `cargo run -- migrate`. Needs BYPASSRLS (to grant
# new permissions to every practice's Owner role) and CREATEROLE (migration
# 0001 creates doctr8_app).
MIGRATION_DATABASE_URL=postgres://doctr8_owner:CHANGE_ME@localhost:5432/doctr8

DB_MAX_CONNECTIONS=10

# --- Auth ---------------------------------------------------------------------
# At least 32 bytes. Rotating it signs everyone out.
JWT_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_BYTES
JWT_ISSUER=doctr8

ACCESS_TOKEN_TTL_SECS=600
REFRESH_TOKEN_TTL_SECS=1209600
# Absolute session lifetime; refreshing never extends past this.
SESSION_TTL_SECS=2592000

# Secure flag on the refresh-token cookie. false only for local plain-HTTP dev.
COOKIE_SECURE=true

# --- Server -------------------------------------------------------------------
BIND_ADDR=127.0.0.1:3000
RUST_LOG=info,doctr8_api=debug
