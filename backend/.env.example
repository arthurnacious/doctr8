# doctr8 backend configuration. Copy to .env and fill in the secrets:
#
#   cp .env.example .env
#   openssl rand -hex 24      # each database password
#   openssl rand -base64 48   # JWT_SECRET
#
# Variables already set in the environment take precedence over .env.

# --- Database -----------------------------------------------------------------
# Runtime connection. The API must end up running as doctr8_app (NOSUPERUSER,
# NOBYPASSRLS) so row-level security is enforced; it refuses to start otherwise.
# Either log in as doctr8_app, or log in as another user and set DATABASE_ROLE
# so every connection does SET ROLE doctr8_app (handy for local dev).
DATABASE_URL=postgres://postgres:CHANGE_ME@127.0.0.1:5432/doctr8
DATABASE_ROLE=doctr8_app

# Used only by `cargo run -- migrate`. Needs a superuser or a role with
# BYPASSRLS + CREATEROLE (migration 0001 creates doctr8_app).
MIGRATION_DATABASE_URL=postgres://postgres:CHANGE_ME@127.0.0.1:5432/doctr8

# Used by tests/e2e/run.sh: this database is DROPPED and recreated on every
# run, so its name must end in _test.
TEST_DATABASE_URL=postgres://postgres:CHANGE_ME@127.0.0.1:5432/doctr8_test

DB_MAX_CONNECTIONS=10

# --- Auth ---------------------------------------------------------------------
# At least 32 bytes. Rotating it signs everyone out.
JWT_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_BYTES
JWT_ISSUER=doctr8

ACCESS_TOKEN_TTL_SECS=600
REFRESH_TOKEN_TTL_SECS=1209600
# Absolute session lifetime; refreshing never extends past this.
SESSION_TTL_SECS=2592000

# Secure flag on the refresh-token cookie. false only for local plain-HTTP dev.
COOKIE_SECURE=true

# --- Server -------------------------------------------------------------------
BIND_ADDR=127.0.0.1:3000
RUST_LOG=info,doctr8_api=debug
